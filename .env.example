# Non-secret local Readstack configuration.
# Copy this file to .env and edit as needed.

READSTACK_SMTP_EMAIL="readstack1@gmail.com"
READSTACK_RECIPIENT_EMAILS="REMOVED, REMOVED"
READSTACK_SMTP_KEYCHAIN_SERVICE="readstack-smtp"

# Required for the Node EPUB generator path (EPUB_GENERATOR=node).
# On macOS the Java/Calibre path can read this from Keychain, but the Node
# path requires it explicitly since it runs outside the Java runtime.
READSTACK_SMTP_PASSWORD="your-gmail-app-password"

# Controls which EPUB conversion path the worker uses.
# "node"    — epub-gen-memory (no Calibre required, works on any server)
# "calibre" — original Java/Calibre pipeline (local only, requires Calibre installed)
# Defaults to "node" if unset.
EPUB_GENERATOR="node"
