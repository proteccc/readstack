# Copy this file to .env and fill in your values.
# All variables are required unless marked optional.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────────────────
# Found in Supabase → Project Settings → Database → Connection string.
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543).
# Use the "Session" pooler or direct URL for DIRECT_URL (port 5432).
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Email delivery (Resend) ───────────────────────────────────────────────────
# Create an account at https://resend.com and generate an API key.
# READSTACK_FROM_EMAIL must be from a domain you have verified in Resend.
# For testing before domain verification, use: onboarding@resend.dev
RESEND_API_KEY=re_...
READSTACK_FROM_EMAIL=readstack@yourdomain.com

# ── Branding ──────────────────────────────────────────────────────────────────
# Displayed in the UI as the approved sender address users should whitelist.
# Should match READSTACK_FROM_EMAIL above.
NEXT_PUBLIC_READSTACK_FROM_EMAIL=readstack@yourdomain.com

# ── Local dev: recipient override ─────────────────────────────────────────────
# Only used when running locally (not in production).
# Comma-separated list: your email + your Kindle email.
READSTACK_RECIPIENT_EMAILS=you@example.com, yourname_xx@kindle.com

# ── Worker ────────────────────────────────────────────────────────────────────
# How often the worker polls for new jobs (milliseconds). Default: 5000.
POLL_INTERVAL_MS=5000

# Controls which EPUB conversion path the worker uses.
# "node"    — epub-gen-memory (default, no extra dependencies)
# "calibre" — original Java/Calibre pipeline (local only, requires Calibre)
EPUB_GENERATOR=node
