# Non-secret local Readstack configuration.
# Copy this file to .env and edit as needed.

READSTACK_RECIPIENT_EMAILS="you@example.com, yourname_xx@kindle.com"

# Resend (https://resend.com) — replaces Gmail SMTP, works on Railway Hobby plan.
# RESEND_API_KEY: create at resend.com/api-keys
# READSTACK_FROM_EMAIL: must be from a domain verified in Resend
#   (or use "onboarding@resend.dev" for testing before domain verification)
RESEND_API_KEY="re_..."
READSTACK_FROM_EMAIL="readstack@yourdomain.com"

# Controls which EPUB conversion path the worker uses.
# "node"    — epub-gen-memory (no Calibre required, works on any server)
# "calibre" — original Java/Calibre pipeline (local only, requires Calibre installed)
# Defaults to "node" if unset.
EPUB_GENERATOR="node"
